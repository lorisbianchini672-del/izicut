# ============================================================
# IziCut — Modèle de configuration
# ------------------------------------------------------------
# Copier ce fichier puis renseigner les vraies valeurs :
#   cp .env.example .env.local && chmod 600 .env.local
# .env.local est ignoré par Git. Ne JAMAIS écrire un secret
# dans le code, ni coller un secret réel dans ce modèle.
# ============================================================

# ---- Application ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Dashboard Supabase -> Project Settings -> API.
# URL du projet : OBLIGATOIRE sous ce nom exact — le middleware et les
# clients navigateur/serveur la lisent via NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique « anon » : exposable au navigateur (protégée par la RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur et worker UNIQUEMENT, contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Alias facultatif (worker, client admin) : par défaut = NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=

# ---- OpenAI (Whisper + GPT) ----
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYZE_MODEL=gpt-4o-mini

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Identifiants de prix créés dans le dashboard Stripe (abonnements)
# — doivent correspondre à lib/plans.ts (pro, agency).
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ---- Crédits / tarification ----
# Aucun réglage d'environnement n'est requis ici.
# Source de vérité des quotas et des prix : lib/plans.ts
#   Free 30 min — Pro 150 min (19 €) — Agency 600 min (59 €)
# Défaut SQL à l'inscription : profiles.video_credits_seconds = 1800 (30 min).
# Les débits sont effectués par les RPC Postgres (reserve_credits /
# release_credits), jamais par du code applicatif.

# ---- Worker (service séparé, hors Vercel) ----
# Secret partagé : le worker signe ses callbacks, l'API les vérifie.
WORKER_TOKEN=change-this-token
# Cadence de scrutation de la file render_jobs.
WORKER_POLL_MS=5000
WORKER_NAME=worker-1
# Nombre de jobs traités en parallèle sur la même machine.
WORKER_CONCURRENCY=2
# Chemins des binaires locaux (le conteneur les fournit).
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
YTDLP_PATH=/usr/local/bin/yt-dlp

# ---- Rendu vidéo ----
# 'local'  : rendu sur la machine du worker (remotion renderMedia)
# 'lambda' : rendu déporté sur AWS Lambda (voir docs/ARCHITECTURE.md)
RENDER_DRIVER=local
REMOTION_LAMBDA_REGION=eu-west-3
REMOTION_LAMBDA_FUNCTION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
